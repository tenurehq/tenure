{
  "name": "tenure",
  "version": "v1.0.36",
  "description": "",
  "license": "MIT",
  "author": "Tenure AI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tenure": "dist/index.js"
  },
  "scripts": {
    "build": "tsgo --project tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "NODE_OPTIONS='--import tsx' ava",
    "test:coverage": "NODE_OPTIONS='--import tsx' c8 ava",
    "test:eval": "NODE_OPTIONS='--import tsx' ava 'src/eval/retrieval.eval.test.ts' 'src/eval/session-retrieval.eval.test.ts' --timeout=5m",
    "test:watch": "ava --watch --ignore='**/*.eval.test.ts'",
    "verify": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.104.1",
    "@fastify/helmet": "13.1.1",
    "@fastify/schedule": "7.0.0",
    "@fastify/static": "10.1.4",
    "@fastify/websocket": "11.3.1",
    "fastify": "5.12.5",
    "jsonrepair": "3.15.0",
    "mongodb": "^7.6.0",
    "mongodb-client-encryption": "7.2.1",
    "smol-toml": "1.8.0",
    "toad-scheduler": "4.2.0",
    "ua-parser-js": "2.0.10"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/sinon": "22.0.0",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260506.1",
    "ava": "8.0.1",
    "c8": "12.0.0",
    "mongodb-memory-server": "11.2.0",
    "sinon": "22.1.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "ava": {
    "timeout": "120s",
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ],
    "files": [
      "src/**/*.test.ts",
      "!src/**/*.eval.test.ts"
    ],
    "workerThreads": false
  }
}
